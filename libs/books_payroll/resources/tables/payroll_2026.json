 "unconfirmed": [
  {
   "path": "colorado.withholding.before2020W4",
   "label": "Colorado withholding for a Form W-4 from 2019 or earlier",
   "note": "DR 1098 (2026), DR 0004, the January 2026 withholding guide and Rule 39-22-604-1 do not say how to treat a 2019-or-earlier Form W-4. QindaBooks uses the married-filing-jointly allowance for \"Married\" and the other allowance otherwise (Publication 15-T's own mapping). Ask the employee for a DR 0004 or a 2026 Form W-4."
  },
  {
   "path": "colorado.opt.glendale.monthlyThreshold",
   "label": "Glendale OPT at exactly $750 a month",
   "note": "Glendale's code taxes compensation of \"no less than $750\" a month; the city's web page says \"more than $750\". QindaBooks follows the code (at least $750)."
  },
  {
   "path": "colorado.famli.wages",
   "label": "FAMLI premium on pre-tax deductions",
   "note": "FAMLI premiums are on \"gross wages\" (7 CCR 1107-1 §1.2(9)): the pay stub's gross, \"pretax earnings\". No FAMLI text says outright that cafeteria-plan (Section 125) reductions stay in it. QindaBooks charges the premium on gross pay before every deduction."
  },
  {
   "path": "colorado.opt.sheridan.dueDay",
   "label": "Sheridan OPT quarterly due date",
   "note": "Sheridan's code lets employers with fewer than ten employees file quarterly but gives no quarterly due date. QindaBooks shows the last day of the month after the quarter, as for monthly returns."
  }
 ],
