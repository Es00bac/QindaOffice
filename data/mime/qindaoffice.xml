<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-qinda-notebook">
    <comment>QindaNote notebook</comment>
    <comment xml:lang="en">QindaNote notebook</comment>
    <glob pattern="*.qnotebook"/>
    <glob pattern="notebook.json" weight="10"/>
  </mime-type>
  <mime-type type="application/x-qindabooks">
    <comment>QindaBooks company file</comment>
    <comment xml:lang="en">QindaBooks company file</comment>
    <sub-class-of type="application/vnd.sqlite3"/>
    <glob pattern="*.qbooks"/>
    <!-- SQLite header, and PRAGMA application_id "QBKS" (0x51424B53) at
         offset 68 — what tells a company file from any other SQLite file. -->
    <magic priority="80">
      <match type="string" value="SQLite format 3\000" offset="0">
        <match type="big32" value="0x51424B53" offset="68"/>
      </match>
    </magic>
  </mime-type>
  <mime-type type="application/x-qindadiagram">
    <comment>QindaDiagram drawing</comment>
    <comment xml:lang="en">QindaDiagram drawing</comment>
    <sub-class-of type="application/json"/>
    <glob pattern="*.qdiagram"/>
    <!-- JSON whose first member is "format": "qindadiagram" (drawing_io.cpp). -->
    <magic priority="60">
      <match type="string" value="&quot;format&quot;: &quot;qindadiagram&quot;" offset="0:64"/>
    </magic>
  </mime-type>
  <mime-type type="application/x-qindabase">
    <comment>QindaBase database</comment>
    <comment xml:lang="en">QindaBase database</comment>
    <sub-class-of type="application/vnd.sqlite3"/>
    <glob pattern="*.qbase"/>
    <!-- SQLite header, and PRAGMA application_id "QBAS" (0x51424153) at
         offset 68 — what tells a QindaBase database from any other SQLite
         file (which QindaBase also opens, as application/vnd.sqlite3). -->
    <magic priority="80">
      <match type="string" value="SQLite format 3\000" offset="0">
        <match type="big32" value="0x51424153" offset="68"/>
      </match>
    </magic>
  </mime-type>
</mime-info>
